// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITOYEN
  AGENT
  ADMIN
}

model Utilisateur {
  id           String   @id @default(uuid())
  nom          String
  prenom       String
  email        String   @unique
  telephone    String?
  motDePasse   String
  role         Role     @default(CITOYEN)
  actif        Boolean  @default(true)
  dateCreation DateTime @default(now())

  demandes       Demande[] @relation("Citoyen")
  demandesPrises Demande[] @relation("Agent")
}

enum StatutDemande {
  BROUILLON
  EN_ATTENTE_PAIEMENT
  EN_TRAITEMENT
  VALIDEE
  DOCUMENT_GENERE
  REJETEE
  ANNULEE
  EXPIREE
}

enum TypePiece {
  IDENTITE
  ACTE_NAISSANCE
  DOMICILE
  PHOTO
  PARENTS
}

enum ModePaiement {
  MOBILE_MONEY
  VISA
}

enum StatutPaiement {
  EN_ATTENTE
  SUCCES
  ECHEC
}

enum StatutDocument {
  PROJET_GENERE
  SIGNE_ENREGISTRE
  REVOQUE
}

model MotifRejet {
  id       String    @id @default(uuid())
  code     String    @unique
  libelle  String
  demandes Demande[]
}

model Demande {
  id             String        @id @default(uuid())
  numeroDossier  String?       @unique
  statut         StatutDemande @default(BROUILLON)

  citoyenId      String
  citoyen        Utilisateur   @relation("Citoyen", fields: [citoyenId], references: [id])
  agentId        String?
  agent          Utilisateur?  @relation("Agent", fields: [agentId], references: [id])

  dateNaissance  DateTime?     @db.Date
  lieuNaissance  String?
  nomPere        String?
  nomMere        String?
  adresse        String?

  motifRejetId   String?
  motifRejet     MotifRejet?   @relation(fields: [motifRejetId], references: [id])

  dateCreation   DateTime      @default(now())
  dateSoumission DateTime?
  datePriseEnCharge DateTime?
  dateDecision      DateTime?
  dateMiseAJour  DateTime      @updatedAt

  pieces         PieceJustificative[]
  paiements      Paiement[]
  document       Document?

  @@index([citoyenId])
  @@index([statut])
}

model PieceJustificative {
  id          String    @id @default(uuid())
  demandeId   String
  demande     Demande   @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  type        TypePiece
  nomFichier  String
  typeMime    String
  taille      Int
  cleStockage String
  dateUpload  DateTime  @default(now())

  @@unique([demandeId, type])
}

model Paiement {
  id             String         @id @default(uuid())
  demandeId      String
  demande        Demande        @relation(fields: [demandeId], references: [id])
  montant        Decimal        @db.Decimal(12, 0)
  devise         String         @default("XAF")
  mode           ModePaiement
  statut         StatutPaiement @default(EN_ATTENTE)
  reference      String         @unique
  cleIdempotence String         @unique
  datePaiement   DateTime       @default(now())

  @@index([demandeId])
}

model Document {
  id                     String         @id @default(uuid())
  demandeId              String         @unique
  demande                Demande        @relation(fields: [demandeId], references: [id])
  identifiantPublic      String         @unique
  statut                 StatutDocument @default(PROJET_GENERE)
  cheminProjet           String
  cheminSigne            String?
  hashSigne              String?
  dateGeneration         DateTime       @default(now())
  dateEnregistrementSigne DateTime?
  motifRevocation        String?
  dateRevocation         DateTime?
}

enum ActionAudit {
  CONNEXION
  CONNEXION_ECHEC
  PRISE_EN_CHARGE
  VALIDATION
  REJET
  PROJET_GENERE
  DOCUMENT_SIGNE
  AGENT_CREE
  AGENT_DESACTIVE
  AGENT_REACTIVE
  DOSSIER_REATTRIBUE
  DOCUMENT_REVOQUE
  FRAIS_MODIFIES
}

model Audit {
  id         String      @id @default(uuid())
  date       DateTime    @default(now())
  action     ActionAudit
  acteurId   String?
  acteurNom  String?
  acteurRole Role?
  demandeId  String?
  dossier    String?
  detail     String?

  @@index([date])
  @@index([action])
}

model Parametre {
  cle           String   @id
  valeur        String
  dateMiseAJour DateTime @updatedAt
}